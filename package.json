{
  "name": "afterlife-ai",
  "version": "1.0.0",
  "description": "CODEXION's Afterlife AI - Multimodal Persona Platform",
  "private": true,

  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend/frontend && npm run dev",
    "dev:backend": "cd backend && py -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "cd frontend/frontend && npm run build",
    "build:frontend": "cd frontend/frontend && npm run build",
    "start": "cd frontend/frontend && npm run start",
    "lint": "cd frontend/frontend && npm run lint",
    "test": "cd frontend/frontend && npm run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "persona",
    "voice-cloning",
    "avatar",
    "rag",
    "llm",
    "multimodal"
  ],
  "author": "CODEXION",
  "license": "Apache-2.0"
}
